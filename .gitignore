# ============================================================
# 构建产物
# ============================================================
# 说明：项目是 backend/ + frontend/ 两个模块并列的结构，
# 所以下面的路径一律用通配前缀，而不是写成固定的某一层。
# 写死层级的话，将来模块一挪就会失效，而且**失效是静默的**——
# 你以为在忽略构建产物，其实已经把它们提交上去了。
target/
!**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ============================================================
# ⚠️ 本地配置与密钥 —— 这一段最重要，别删
# ============================================================
# 绝对不要把数据库密码、API Key 提交到 Git。
# 一旦推到 GitHub，即使立刻删除，历史提交里依然查得到，
# 而且爬虫会在几分钟内扫到并开始盗用。
#
# 正确做法：
#   1. 敏感配置写在 application-local.yml（本文件已被忽略）
#   2. 或者用环境变量（见 README）
#   3. 仓库里只保留 application.yml 里的 ${VAR:default} 占位符
# ============================================================
application-local.yml
application-local.properties
application-secret.yml
.env
.env.local
*.key
*.pem

# ============================================================
# 日志
# ============================================================
*.log
logs/
spring.log

# ============================================================
# IDE
# ============================================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ============================================================
# 操作系统
# ============================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# ============================================================
# 其它
# ============================================================
HELP.md
*.tmp
*.bak
