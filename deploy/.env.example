# 复制成 deploy/.env 后在服务器本机填写，禁止提交或粘贴真实值。
COMPOSE_PROJECT_NAME=travelmind-prod
DEPLOY_DOMAIN=aviatote.com
ACME_EMAIL=
RELEASE_TAG=
CADDY_IMAGE=caddy:2-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
POSTGRES_DB=travelmind_production
DB_USER=travelmind_app
# 两个不同的随机密码；不允许沿用开发默认值。
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
BACKUP_DIR=/opt/travelmind/shared/backups
AMAP_ENABLED=false
AMAP_KEY=
# 默认不替公众付模型费用，启用前必须确认额度和滥用控制。
AI_ENABLED=false
AI_ALLOW_USER_KEYS=false
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash
# 演示额度（保守 token 预留，非美元）；累计计数持久化，重启不会清零。
AI_PER_USER_PER_MINUTE=6
AI_MAX_CONCURRENT=2
AI_MAX_DAILY_REQUESTS=100
AI_MAX_TOTAL_REQUESTS=300
AI_MAX_DAILY_RESERVED_TOKENS=200000
AI_MAX_TOTAL_RESERVED_TOKENS=1000000
AI_MAX_PROMPT_CHARACTERS=20000
AI_MAX_TRACKED_USERS=1024
